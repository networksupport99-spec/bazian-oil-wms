# Copy this to .env for local development
# On Railway/Render these are set in the dashboard

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret — change this to a long random string in production
JWT_SECRET=bazian-oil-wms-secret-key-change-in-prod-2026

# Server port (Railway sets this automatically)
PORT=8081
